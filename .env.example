# ============================================
# SUPABASE (Banco de Dados)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada

# ============================================
# MILLENNIUM API (Integração ERP)
# ============================================
# Credenciais de acesso à API do Millennium
MILLENNIUM_USER=seu-usuario-api
MILLENNIUM_PASS=sua-senha-api

# Chave secreta para validar webhooks vindos do Millennium
MILLENNIUM_WEBHOOK_SECRET=chave-secreta-para-webhooks

# ============================================
# CONFIGURAÇÕES DO SISTEMA
# ============================================
# Ambiente: development | staging | production
NODE_ENV=development

# URL do frontend (para callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# FEATURE FLAGS
# ============================================
# Habilitar sincronização automática com Millennium
ENABLE_MILLENNIUM_SYNC=true

# Intervalo de sincronização em minutos (0 = desabilitado)
SYNC_INTERVAL_MINUTES=60

# ============================================
# IA / AUTOMACAO (Opcional)
# ============================================
# OpenAI - para respostas automáticas
OPENAI_API_KEY=sk-sua-chave-openai

# Configuração do assistente de vendas
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MODEL=gpt-4
